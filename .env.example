# Copy to .env.local and fill in. Never commit real keys.
# Without any AI key the app still works: it falls back to rule-based explanations.

# AI explanations: set ONE of these (or both, then AI_PROVIDER picks).
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Google Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. "gemini-flash-latest" tracks the newest Flash model.
GEMINI_MODEL=gemini-flash-latest
# Optional: "openai" or "gemini". Only matters when both keys are set (default: gemini).
# AI_PROVIDER=openai

# Optional but recommended: live readings from ground stations. Source order:
# OpenAQ stations, then the nearest WAQI station, then a ~40 km model estimate
# (which can differ from local readings).
# OpenAQ key (free): https://explore.openaq.org/register
OPENAQ_API_KEY=
# WAQI / aqicn.org token (free): https://aqicn.org/data-platform/token/
WAQI_TOKEN=
